<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>pt-BR</string>
	<key>CFBundleDisplayName</key>
	<string>LabPlayer</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Carimbado pelo CI com o commit de origem. Existe para responder na
	     tela "qual build é este?" — sem isso não dá para distinguir um app que
	     não mudou de um .ipa antigo instalado por engano. -->
	<key>LabPlayerBuild</key>
	<string>local</string>

	<!-- Deixa o app aparecer no Files e abrir arquivos "no lugar"
	     (pendrive USB, iCloud, outros apps) sem copiar. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- Áudio continua com a tela bloqueada. Não exige entitlement pago. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- SMB no homelab: iOS 14+ exige permissão explícita de rede local. -->
	<!-- Só para gravar a captura de tela do vídeo; o app não lê suas fotos. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Para salvar a captura de tela do vídeo no seu álbum.</string>

	<key>NSLocalNetworkUsageDescription</key>
	<string>O LabPlayer precisa da rede local para listar e reproduzir vídeos do seu servidor — compartilhamentos SMB e bibliotecas do Jellyfin.</string>

	<!-- Servidor caseiro fala HTTP puro, e o iOS bloqueia isso por padrão.
	     NSAllowsLocalNetworking sozinho não bastaria: ele libera as faixas
	     privadas clássicas (10.x, 172.16.x, 192.168.x), e um Jellyfin
	     alcançado por Tailscale responde em 100.64.x, que fica de fora.
	     Este app é pessoal e instalado à mão; não passa por revisão da
	     Apple, então a permissão ampla é escolha consciente e não um
	     atalho para contornar análise. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_smb._tcp</string>
	</array>

	<!-- Dict vazio = tela de lançamento padrão. Sem esta chave o iOS roda o
	     app em caixa reduzida, sem ocupar a tela toda. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!-- Faz o LabPlayer aparecer em "Abrir com" para qualquer vídeo. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Vídeo</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.video</string>
				<string>public.audiovisual-content</string>
				<string>org.matroska.mkv</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.matroska.mkv</string>
			<key>UTTypeDescription</key>
			<string>Matroska Video</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.movie</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mkv</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>video/x-matroska</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
