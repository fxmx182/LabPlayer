<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Ler vídeo do aparelho mudou de nome no Android 13. As duas linhas
         precisam existir: a nova para os aparelhos novos, a velha limitada por
         maxSdkVersion para os antigos — sem o teto, o Android 13+ reclama de
         pedir uma permissão que não existe mais. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Pendrive por USB-C entra montado pelo sistema e aparece no MediaStore
         como qualquer outro volume; não há permissão especial a pedir. -->

    <!-- Um APK só, para celular e televisão.
         `leanback` e `touchscreen` ficam os dois como NÃO obrigatórios: exigir
         o primeiro tiraria o app da Play Store de celular, e exigir o segundo
         o tiraria da de TV. Sem tela sensível ao toque o app continua inteiro,
         porque a camada de controle remoto cobre tudo o que o dedo fazia. -->
    <!-- `leanback` e a categoria da tela inicial vivem nos manifestos de cada
         variante: é o que torna um APK exclusivo do celular e o outro da TV. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Recursos que a televisão não tem, declarados como NÃO obrigatórios.
         Isto não é excesso de zelo: algumas permissões declaram um recurso
         obrigatório por conta própria, e a que faz isso aqui é a
         ACCESS_WIFI_STATE, que implica `android.hardware.wifi` como EXIGIDO.
         Uma TV ligada por cabo — ou cujo firmware simplesmente não anuncia
         wifi — é filtrada por causa disso e responde "este app não é
         compatível com sua TV", sem dizer qual recurso faltou.
         O app nunca precisou de wifi: ele precisa de rede, e cabo é rede. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:name=".ViperApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Viper"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Viper">
        </activity>

        <activity
            android:name=".player.PlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|layoutDirection|density"
            android:theme="@style/Theme.Viper.Player">

            <!-- "Abrir com" para qualquer vídeo, como no Info.plist do iOS. -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/x-matroska" />
                <data android:mimeType="application/mp4" />
                <data android:scheme="file" />
                <data android:scheme="content" />
            </intent-filter>

            <!-- Os contêineres que o Android não sabe rotular. Sem estas
                 linhas, um .mkv num gerenciador de arquivos chega com tipo
                 genérico e o app nem aparece na lista de "abrir com". -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.m2ts" />
                <data android:pathPattern=".*\\.rmvb" />
                <data android:pathPattern=".*\\.flv" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\.wmv" />
                <data android:pathPattern=".*\\.divx" />
                <data android:pathPattern=".*\\.vob" />
            </intent-filter>

            <!-- smb:// e http(s):// direto de outro app. -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="smb" />
            </intent-filter>
        </activity>
    </application>
</manifest>
