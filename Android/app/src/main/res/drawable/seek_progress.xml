<?xml version="1.0" encoding="utf-8"?>
<!-- Três camadas: o trilho, o quanto já carregou e o quanto já passou.
     A do meio é o que o YouTube mostra em cinza mais claro — sem ela, uma
     espera no meio do filme é indistinguível de um travamento. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#73FFFFFF" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/libertyx_accent" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
