<?xml version="1.0" encoding="utf-8"?>
<!-- A placa de cada ferramenta.

     No lugar do disco cinza: o disco obrigava o ícone a ser pequeno no meio de
     muito vazio, e quinze discos iguais viravam um tabuleiro sem hierarquia. A
     placa ocupa a célula inteira, cabe ícone, nome e valor, e quando a
     ferramenta está ligada é a placa toda que acende em dourado — dá para ver
     de relance o que está ativo, sem ler. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EFBC501" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="@color/libertyx_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#29FBC501" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#59FBC501" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFBC501" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#73FBC501" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#16FFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</selector>
