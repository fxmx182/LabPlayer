<?xml version="1.0" encoding="utf-8"?>
<!-- A folha de ferramentas é transparente: os anéis flutuam sobre o próprio
     filme, que continua à vista atrás deles. Quem garante a leitura é o véu
     da janela (escurece a cena por igual), o fundo escuro dentro de cada anel
     e a sombra dos nomes — não um bloco preto tapando metade da tela. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
