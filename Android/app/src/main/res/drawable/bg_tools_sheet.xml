<?xml version="1.0" encoding="utf-8"?>
<!-- A folha de ferramentas: preto de verdade, como a tela ao redor do filme.
     Qualquer cinza aqui virava um bloco sobre a imagem; o preto some e deixa
     só os anéis à vista. Um fio quase invisível marca a borda de cima. -->
