<?xml version="1.0" encoding="utf-8"?>
<!-- O play sem disco em repouso: o ícone largo basta, e o disco cinza pesava
     no meio da fileira. O círculo só aparece no toque — e, na TV, o anel
     dourado de foco continua sendo o alvo inicial do controle. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#3DFBC501" />
            <stroke android:width="2dp" android:color="@color/libertyx_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
