<?xml version="1.0" encoding="utf-8"?>
<!-- O fundo das caixas de escolha — faixas de áudio, legenda, velocidade,
     retomar de onde parou.

     O material é o mesmo da folha de ferramentas: preto quente, cantos
     generosos e um fio claro na borda. Antes era um retângulo de cantos retos
     do tema do sistema, e ao lado da folha nova parecia de outro app. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF16110B"
        android:endColor="#FF0C0907" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
