<?xml version="1.0" encoding="utf-8"?>
<!--
  O estado de foco dos botões do player.

  No celular ele nunca aparece: dedo não dá foco. Na televisão ele é a única
  coisa que diz onde o controle remoto está — e o realce padrão do Android é um
  círculo cinza que, a três metros e sobre imagem clara, some. Aqui o botão
  focado ganha o amarelo da marca por dentro e por fora.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3DFBC501" />
            <stroke android:width="2dp" android:color="@color/libertyx_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
