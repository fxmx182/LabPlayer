<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Viper" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/viper_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- O player é preto de verdade, não o cinza do fundo do app: qualquer
         claridade em volta da imagem aparece no escuro. -->
    <style name="Theme.Viper.Player" parent="Theme.Viper">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Botões da barra: alvo grande de toque, ícone pequeno. O dedo erra o
         que tem 24dp; o olho se cansa do que tem 48. -->
    <style name="PlayerIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/btn_player</item>
    </style>

    <!-- Na fileira de baixo a largura é dividida, não fixada. -->
    <style name="PlayerIconWeighted" parent="PlayerIcon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:padding">11dp</item>
    </style>
</resources>
