    <string name="gf_audio">Switches the soundtrack: dubbed, original, director\'s commentary.</string>
    <string name="gf_legenda">Turns on, off and picks among the file\'s subtitles.</string>
    <string name="gf_repetir">Repeats the current video nonstop. Lights up while it is on.</string>
    <string name="gf_girar">Automatic, landscape or portrait — and the third tap goes back to automatic.</string>
    <string name="gf_velocidade">From 0.5× to 2×, for when speech runs too fast or too slow.</string>
    <string name="gf_dormir_n">Sleep</string>
    <string name="gf_dormir">Sleep timer: pauses by itself after the minutes you choose.</string>
    <string name="gf_noturno_n">Night</string>
    <string name="gf_noturno">Dims the picture below the system minimum, for watching in the dark.</string>
    <string name="gf_captura_n">Capture</string>
    <string name="gf_captura">Saves the frame on screen to Pictures.</string>
    <string name="gf_janela_n">Window</string>
    <string name="gf_janela">Floating window: the video keeps going in a corner while you use another app.</string>
    <string name="gf_quadro">Exact seeking while dragging. Turn it off for heavy files over the network.</string>
    <string name="gf_bloquear_n">Lock</string>
    <string name="gf_bloquear">The padlock on the bottom bar blocks touches — movie in your pocket, kid on your lap.</string>
    <string name="gf_mudo">Silences only the video; a crossed-out speaker stays at the top while it lasts.</string>
    <string name="gf_proporcao">Fit, fill or stretch the picture on the screen.</string>
