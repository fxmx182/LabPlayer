<?xml version="1.0" encoding="utf-8"?>
<!-- O painel de ferramentas: uma grade de quatro anéis sobre preto.

     Tudo aparece de uma vez e o dedo vai direto ao desenho — é como se procura
     ferramenta durante um filme. Sem pega: a folha não arrasta, e uma pega que
     não arrasta promete o que não cumpre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tools_sheet"
    android:paddingTop="18dp"
    android:paddingBottom="22dp">

    <ScrollView
        android:id="@+id/tools_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="10dp"
        android:clipToPadding="false">

        <GridLayout
            android:id="@+id/tools_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4" />
    </ScrollView>
</LinearLayout>
