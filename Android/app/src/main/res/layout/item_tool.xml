<?xml version="1.0" encoding="utf-8"?>
<!--
  Uma ferramenta do painel: ícone, nome e, quando existe, o valor em que ela
  está. O valor à mostra é o que evita abrir a ferramenta só para descobrir em
  quanto ela está — velocidade, rotação, tempo da barra.

  O nome ocupa sempre duas linhas e o valor sempre uma, mesmo vazios: assim
  todas as placas da grade têm a mesma altura, e a grade fica alinhada em vez
  de serrilhada.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="8dp"
    android:paddingHorizontal="6dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_tool_tile">

    <ImageView
        android:id="@+id/tool_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tool_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="1dp"
        android:textColor="#D9FFFFFF"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/tool_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center_horizontal"
        android:lines="1"
        android:ellipsize="end"
        android:textColor="@color/libertyx_accent"
        android:textSize="10.5sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
